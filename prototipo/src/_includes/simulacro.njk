{#- Solo del simulacro: no existe en OJS. Pastilla discreta abajo a la izquierda. -#}
<details class="ps-simulacro">
  <summary>Simulacro</summary>
  <div class="ps-simulacro-panel">
    <p>Web de ejemplo de {{ revista.nombre }}. Artículos, autores y datos ficticios; textos del equipo en borrador.</p>
    <p>Ver la portada:
      <a href="index.html"{% if page.url == "/" %} aria-current="page"{% endif %}>durante la convocatoria</a> ·
      <a href="inicio-publicada.html"{% if page.url == "/inicio-publicada.html" %} aria-current="page"{% endif %}>con el primer número</a>
    </p>
    {%- if page.url == "/" %}
    <p data-cal-simula></p>
    {%- endif %}
  </div>
</details>
<script>
// La pastilla taparía la línea de la convocatoria de la portada (en el móvil y en pantallas medianas, donde el texto empieza
// pegado al borde): se esconde mientras esa línea se ve y la pastilla la pisa. En monitores anchos queda a la vista.
(function(){
  var sim = document.querySelector('.ps-simulacro'), acc = document.querySelector('.ps-hero--foto .ps-actions'), cont = document.querySelector('.ps-hero-cont');
  if (!sim || !acc || !cont || !('IntersectionObserver' in window)) return;
  var visible = false;
  function pisa(){
    var c = cont.getBoundingClientRect(), izq = c.left + parseFloat(getComputedStyle(cont).paddingLeft);
    return izq < sim.getBoundingClientRect().right + 8;
  }
  function poner(){ sim.classList.toggle('is-tapando', visible && pisa()); }
  new IntersectionObserver(function(e){ visible = e[0].isIntersecting; poner(); }).observe(acc);
  window.addEventListener('resize', poner);
})();
</script>
