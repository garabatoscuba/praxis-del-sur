{#- Solo del simulacro: no existe en OJS. Pastilla discreta abajo a la izquierda. -#}
<details class="ps-simulacro">
  <summary>Simulacro</summary>
  <div class="ps-simulacro-panel">
    <p>Web de ejemplo de {{ revista.nombre }}. Artículos, autores y datos ficticios; textos del equipo en borrador.</p>
    <p>Ver la portada:
      <a href="index.html"{% if page.url == "/" %} aria-current="page"{% endif %}>durante la convocatoria</a> ·
      <a href="inicio-publicada.html"{% if page.url == "/inicio-publicada.html" %} aria-current="page"{% endif %}>con el primer número</a>
    </p>
    {%- if page.url == "/" %}
    <p data-cal-simula></p>
    {%- endif %}
  </div>
</details>
<script>
// En el móvil, la pastilla taparía el botón «Enviar contribución» de la portada: se esconde mientras esos botones se ven.
(function(){
  var sim = document.querySelector('.ps-simulacro'), acc = document.querySelector('.ps-hero--foto .ps-actions');
  if (!sim || !acc || !('IntersectionObserver' in window)) return;
  var movil = window.matchMedia('(max-width: 760px)');
  new IntersectionObserver(function(e){ sim.classList.toggle('is-tapando', e[0].isIntersecting && movil.matches); }).observe(acc);
})();
</script>
