{#- Equivale a frontend/components/header.tpl + footer.tpl de OJS 3.5 (pkp-lib). -#}
{%- set isEntry = site.artifact and page.url == "/" -%}
{%- if not isEntry %}<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- endif %}
<title>{% if title and page.url != "/" %}{{ title }} | {% endif %}{{ revista.nombre }}{% if page.url == "/" %} · {{ revista.firma }}{% endif %}</title>
<meta name="description" content="{{ descripcion or revista.descripcion }}">
{#- Simulacro con textos en borrador: que los buscadores no lo muestren aunque esté publicado. Se quita en la revista real. #}
<meta name="robots" content="noindex, nofollow">
{%- if site.artifact %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap">
{%- else %}
<link rel="icon" href="img/favicon.svg" type="image/svg+xml">
{%- endif %}
{% estilos %}
<style>:root { --ps-cab-dur: {{ cabecera.duracion }}; --ps-cab-llegada: {{ cabecera.llegada }}; --ps-cab-transp: {{ cabecera.transparencia }}; --ps-cab-encoge: {{ cabecera.encoge }}; --ps-mov-dist: {{ movimiento.distancia }}; --ps-mov-dur: {{ movimiento.duracion }}; --ps-mov-escalon: {{ movimiento.escalon }}; --ps-mov-raton: {{ movimiento.raton }}; }</style>
{%- if not isEntry %}
</head>
<body class="pkp_page_{{ pkpPage or 'index' }} pkp_op_{{ pkpOp or 'index' }} has_site_logo">
{%- endif %}
<div class="pkp_structure_page{% if cabeceraSobreHeroe %} ps-sobre-heroe{% endif %}">
{% include "header.njk" %}
<div class="pkp_structure_content">
<div class="pkp_structure_main" role="main">
<a id="pkp_content_main"></a>
{{ content | safe }}
</div>
</div>
{% include "footer.njk" %}
</div>
<script>
window.PS_CABECERA = { umbral: {{ cabecera.umbral }} };
(function () {
  // Cada página nueva abre arriba, salvo que el enlace lleve a una sección (#…). Dentro del visor de claude.ai la página va en un
  // marco y el visor conserva la posición al cambiar de página: scrollIntoView sube también el marco.
  if (!location.hash) {
    try { if ('scrollRestoration' in history) history.scrollRestoration = 'manual'; } catch (e) {}
    var arriba = function () {
      window.scrollTo(0, 0);
      if (window.parent !== window) { try { document.documentElement.scrollIntoView({ block: 'start', behavior: 'instant' }); } catch (e) {} }
    };
    arriba();
    window.addEventListener('pageshow', function (e) { if (!e.persisted) arriba(); });
  }

  // Índice lateral («En esta página»): marca la sección por la que vas. Se mide al cargar y al cambiar de tamaño, no en cada scroll.
  var toc = document.querySelector('.ps-toc');
  if (toc) {
    var enlaces = [].slice.call(toc.querySelectorAll('a[href^="#"]')), tops = [], actual = null, pend = false;
    var secciones = enlaces.map(function (a) { return document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1))); });
    var margen = function () { return (parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 80) + 40; };
    var medirToc = function () {
      var y = window.scrollY || 0;
      tops = secciones.map(function (s) { return s ? s.getBoundingClientRect().top + y : Infinity; });
      marcar();
    };
    var marcar = function () {
      pend = false;
      var y = (window.scrollY || 0) + margen(), i = 0;
      for (var k = 0; k < tops.length; k++) if (tops[k] <= y) i = k;
      // al llegar al final de la página, la última sección
      if ((window.scrollY || 0) + window.innerHeight >= document.documentElement.scrollHeight - 4) i = tops.length - 1;
      if (actual === i) return;
      actual = i;
      enlaces.forEach(function (a, k) {
        a.classList.toggle('is-actual', k === i);
        if (k === i) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
      });
    };
    window.addEventListener('scroll', function () { if (!pend) { pend = true; requestAnimationFrame(marcar); } }, { passive: true });
    window.addEventListener('resize', medirToc);
    if (window.ResizeObserver) new ResizeObserver(medirToc).observe(document.body);
    enlaces.forEach(function (a, k) { a.addEventListener('click', function () { setTimeout(function () { actual = null; marcar(); }, 60); }); });
    medirToc();
  }

  // Cabecera: en la portada va transparente sobre el bloque vino y la barra aparece al bajar.
  var head = document.querySelector('.pkp_structure_head');
  var sobre = head && head.classList.contains('ps-head--sobre');
  var menuAbierto = false;
  function cabecera() {
    if (!head) return;
    var pasado = (window.scrollY || 0) > ((window.PS_CABECERA && window.PS_CABECERA.umbral) || 0);
    head.classList.toggle('is-compact', pasado);
    if (sobre) head.classList.toggle('is-solid', pasado || menuAbierto);
  }
  window.__psCabecera = cabecera;
  window.addEventListener('scroll', cabecera, { passive: true });
  cabecera();

  var toggle = document.querySelector('.pkp_site_nav_toggle');
  var menu = document.getElementById('siteNavMenu');
  if (toggle && menu) {
    toggle.addEventListener('click', function () {
      menuAbierto = menu.classList.toggle('is_open');
      toggle.setAttribute('aria-expanded', menuAbierto ? 'true' : 'false');
      toggle.querySelector('span').textContent = menuAbierto ? 'Cerrar' : 'Menú';
      cabecera();
    });
  }
  function select(el) {
    var range = document.createRange(); range.selectNodeContents(el);
    var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(range);
  }
  document.querySelectorAll('[data-copiar]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var el = document.getElementById(btn.getAttribute('data-copiar'));
      var label = btn.textContent;
      var done = function () {
        btn.textContent = 'Copiada'; el.classList.add('is-copiada');
        setTimeout(function () { el.classList.remove('is-copiada'); }, 160);
        setTimeout(function () { btn.textContent = label; }, 1800);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(el.innerText).then(done, function () { select(el); });
      } else { select(el); }
    });
  });
})();
</script>
{% include "movimiento.njk" %}
{%- if not isEntry %}
</body>
</html>
{%- endif %}
