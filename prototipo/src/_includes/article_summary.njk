{#- Equivale a frontend/objects/article_summary.tpl. Espera la variable «a». -#}
{%- set secA = secciones | bySlug(a.seccion) -%}
{%- set badgeSeccion = secA -%}
<div class="obj_article_summary">
  {%- if mostrarSeccion %}
  <p class="ps-summary-meta"><span class="ps-section-label">{{ secA.nombre }}</span>{% include "badge.njk" %}</p>
  {%- endif %}
  <{{ hArticulo or "h3" }} class="title">
    <a id="article-{{ a.id }}" href="articulo-{{ a.slug }}.html">{{ a.titulo }}</a>
  </{{ hArticulo or "h3" }}>
  <div class="meta">
    <div class="authors">{% for au in a.autores %}<button type="button" class="ps-autor-btn" data-ficha="{{ au | fichaId }}" aria-haspopup="dialog">{{ au | nombreCompleto }}</button>{% if not loop.last %}, {% endif %}{% endfor %}</div>
    <div class="pages">{{ a.id }}</div>
    {%- if mostrarFecha %}<div class="published">{{ a.publicado | fechaCorta }}</div>{% endif %}
  </div>
  <ul class="galleys_links">
    {%- for g in a.galeradas %}
    <li><a class="obj_galley_link {{ g | lower }}" href="articulo-{{ a.slug }}.html">{{ g }}</a></li>
    {%- endfor %}
  </ul>
</div>
