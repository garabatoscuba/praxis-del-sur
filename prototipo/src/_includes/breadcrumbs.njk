{#- Equivale a frontend/components/breadcrumbs.tpl y breadcrumbs_article.tpl. Espera «migas»: [{label, url}] -#}
<nav class="cmp_breadcrumbs" role="navigation" aria-label="Estás aquí:">
  <ol>
    <li><a href="index.html">Inicio</a><span class="separator">/</span></li>
    {%- for m in migas %}
    {%- if m.url %}
    <li><a href="{{ m.url }}">{{ m.label }}</a><span class="separator">/</span></li>
    {%- else %}
    <li class="current" aria-current="page"><span aria-current="page">{{ m.label }}</span></li>
    {%- endif %}
    {%- endfor %}
  </ol>
</nav>
